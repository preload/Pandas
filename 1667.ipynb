   "cell_type": "code",
   "source": [
    "df = pd.DataFrame({\n",
    "    'user_id': [1, 2],\n",
    "    'name': ['aLice', 'bOB']\n",
    "})\n",
    "\n",
    "def fix_names(df: pd.DataFrame) -> pd.DataFrame:\n",
    "    df['name'] = df['name'].str.capitalize()\n",
    "    return df.sort_values('user_id',ascending=True)"
   ],
